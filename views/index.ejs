<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carryora</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="min-h-screen flex flex-col">

        <div class="p-10">
            <h2 class="text-2xl font-semibold tracking-tighter text-center"> Welcome to </h2>
            <h1 class="text-4xl font-bold text-blue-600 text-center tracking-wider"> Carryora </h1>
            <h3 class="text-center text-sm font-semibold tracking-[2px]">"Carry Your Style"</h3>
        </div>

        <div class="w-full flex-1 flex justify-center items-center">
            <div class="w-1/2 flex flex-col px-40">
                <h1 class="text-2xl font-semibold">Create Your Account</h1>

                <form class="flex flex-col gap-3 mt-3" action="/users/register" method="post">
                    <input class="px-4 py-2 rounded-md bg-zinc-100 border-2 border-zinc-200 outline-none" type="text" placeholder="Full Name" name="fullname">
                    <input class="px-4 py-2 rounded-md bg-zinc-100 border-2 border-zinc-200 outline-none" type="email" placeholder="Email" name="email">
                    <input class="px-4 py-2 rounded-md bg-zinc-100 border-2 border-zinc-200 outline-none" type="password" placeholder="Password" name="password">
                    <input class="px-4 py-2 bg-blue-600 rounded-full text-white self-start" type="submit" value="Create My Account">
                </form>
            </div>

            <div class="w-1/2  flex flex-col px-40">
                <h1 class="text-2xl font-semibold">Login Your Accout</h1>

                <form class="flex flex-col gap-3 mt-3" action="/users/login" method="post">
                    <input class="px-4 py-2 rounded-md bg-zinc-100 border-2 border-zinc-200 outline-none" type="email" placeholder="Email" name="email">
                    <input class="px-4 py-2 rounded-md bg-zinc-100 border-2 border-zinc-200 outline-none" type="password" placeholder="Password" name="password">
                    <input class="px-4 py-2 bg-blue-600 rounded-full text-white self-start" type="submit" value="Login">
                </form>
            </div>


        </div>
    </div>
</body>

</html>