<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carryora</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-hidden">
    <!-- navbar -->
    <div
        class="fixed top-0 left-0 w-full h-20 z-50 flex justify-between items-center px-8 border-b border-zinc-200 bg-white">
        <h1 class="text-3xl font-bold text-mauve-700 tracking-widest">Carryora👜</h1>
        <ul class="flex gap-10 text-lg">
            <li class="hover:scale-120 transition duration-200"><a href="">Home</a></li>
            <li class="hover:scale-120 transition duration-200"><a href="">Products</a></li>
            <li class="hover:scale-120 transition duration-200"><a href="">Cart</a></li>
            <li class="hover:scale-120 transition duration-200"><a href="">My Account</a></li>
        </ul>
    </div>

    <div class="flex flex-row gap-10 mt-20 py-10 px-8 h-[calc(100vh-5rem)] overflow-y-auto">
        <div class="w-75 h-100 overflow-hidden rounded-md">
            <div class="h-[85%] flex items-center justify-center bg-mauve-200">
                <img class="w-full h-full object-contain"
                    src="https://www.drakensberg.in/cdn/shop/files/Sam-DuffleBag-Navy-Blue-Side-tilt.photo_1080x1080.webp?v=1764588691"
                    alt="">
            </div>
            <div class="w-full px-3 flex justify-between bg-neutral-500 py-4">
                <div>
                    <h1 class="text-xl font-semibold">Cling Bag</h1>
                </div>
                <div>
                    <form action="">
                        <input
                            class="w-8 h-8 text-2xl font-bold rounded-full bg-white justify-center items-center hover:scale-95 transition duration-200"
                            type="submit" value="+">
                        <label class="w-8 h-8 px-2 text-xl rounded-sm bg-white justify-center items-center"
                            for="">01</label>
                        <input
                            class="w-8 h-8 text-2xl font-bold rounded-full bg-white justify-center items-center hover:scale-95 transition duration-200"
                            type="submit" value="-">
                    </form>
                </div>
            </div>
        </div>
        <div>
            <h3 class="text-2xl font-semibold mb-4">Price Breakdown</h3>
            <div class="pl-4 flex flex-col gap-2 border-b-2 border-zinc-200 pb-5">
                <div class="flex w-80 justify-between">
                    <span>Total MRP</span>
                    <span>₹ 1920</span>
                </div>
                <div class="flex w-80 justify-between">
                    <span>Discount MRP</span>
                    <span>₹ 1920</span>
                </div>
                <div class="flex w-80 justify-between">
                    <span>Platform Fee</span>
                    <span>₹ 1920</span>
                </div>
                <div class="flex w-80 justify-between">
                    <span>Shipping Charge</span>
                    <span>Free</span>
                </div>
            </div>
            <div class="flex w-80 justify-between py-5">
                <span class="font-semibold text-lg">Total Amount</span>
                <span class="font-semibold text-lg">₹</span>
            </div>
            <form action="">
                <input class="bg-black text-white px-4 py-2 rounded-md hover:scale-95 transition duration-200"
                    type="submit" value="Place Order">
            </form>

        </div>
    </div>
</body>

</html>