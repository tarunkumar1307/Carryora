<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Cart | Carryora
    </title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-hidden">
    <!-- navbar -->
    <%- include('./partials/navbar', {pageTitle: 'Cart' }) %>
    
    <% 
    const platformFee=15; 
    let totalMRP = 0;
    let discount = 0;
    let shippingcharge = 0;

    user.cart.forEach((product)=>{
        totalMRP += product.price;
        discount += (product.price * product.discount/100);
    })

    if(totalMRP-discount+platformFee < 500) shippingcharge = 150;

    const totalAmount = totalMRP - discount + platformFee + shippingcharge;
    %>
    
    <div class="flex">
        <!-- left section -->
        <div class="fixed left-0 top-20 w-1/6 h-[calc(100vh-5rem)] px-6 py-10 border-r border-zinc-200">
            <a class="block px-2 py-2 hover:bg-zinc-100 rounded-md tracking-tighter flex items-center gap-2" href="/cart"><img class="w-4 h-4" src="/images/grocery-store.png" alt="Cart">My Cart</a>
            <a class="block px-2 py-2 hover:bg-zinc-100 rounded-md tracking-tighter flex items-center gap-2" href="/shop"><img class="w-3 h-3" src="/images/arrow.png" alt="Left Arrow" srcset="">Continue Shopping</a>
        </div>

        <!-- right section -->
        <div class="ml-[17%] mt-20 p-10 h-[calc(100vh-5rem)] w-5/6 overflow-y-auto">

            <div class="flex justify-between">
                <div class="flex gap-3 items-center">
                    <h1 class="text-2xl font-semibold">My Cart</h1>
                    <h3 class="px-8 py-1 bg-pink-100 rounded-md text-pink-800   ">
                        <%= user.cart.length %> items
                    </h3>
                </div>
    
                <a class="px-4 py-2 rounded-md bg-neutral-200 hover:scale-95 transition duration-200 flex items-center gap-2 font-semibold" href="/shop"> <img class="w-3 h-3" src="/images/arrow.png" alt="Left Arrow">Continue Shopping</a>
            </div>
    
            <p class="text-zinc-400 tracking-tighter text-sm">Review your items and proceed to Checkout.</p>
    
            <div class="flex">
                <div class="w-[45rem] flex flex-col gap-3 p-4">

                    <% user.cart.forEach((product)=>{ %>
                        <div class="flex justify-between border border-zinc-200 h-36 p-3 gap-3 rounded-md shadow">
                            <div class="flex gap-5">
                                <div class="h-30 w-30 rounded-md bg-[<%= product.bgcolor %>]">
                                    <img class="w-full h-full object-contain p-2 " src="data:<%= product.contentType %>;base64, <%= product.image.toString('base64') %>" alt="Bag">
                                </div>

                                <div class="mt-2">
                                    <h2 class="text-lg font-semibold tracking-tighter">
                                        <%= product.name %>
                                    </h2>
                                    <% if(Number(product.discount)> 0){ %>
                                        <div class="flex gap-5">
                                            <h3>
                                                ₹ <%= product.price - (product.price*product.discount/100) %>
                                            </h3>
                                            <h3 class="text-zinc-400 line-through">
                                                ₹ <%= product.price %>
                                            </h3>
                                            <h3
                                                class="px-3 py-1 bg-[<%= product.bgcolor %>] rounded-sm text-[<%= product.textcolor %>]">
                                                <%= product.discount %>% OFF
                                            </h3>
                                        </div>
                                    <% } else { %>
                                        <div class="flex gap-5">
                                            <h3>
                                                ₹ <%= product.price %>
                                            </h3>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
    
                            <div class="flex flex-col justify-center gap-3 items-center mr-10">
                                <div class="bg-zinc-200 p-2 rounded-md">
                                    <span class="px-2 cursor-pointer">
                                        +
                                    </span>
                                    <span class="px-2 cursor-pointer">
                                        1
                                    </span>
                                    <span class="px-2 cursor-pointer">
                                        -
                                    </span>
                                </div>
                                <a class="text-red-600 font-semibold transition duration-200 hover:scale-105" href="/cart/remove/<%= product._id %>"> Remove </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
                        
                <div class="ml-10 mt-4 w-[26rem] h-100 rounded-md shadow overflow-hidden">
                    <h1 class="px-4 py-3 font-semibold bg-zinc-200">Price Details</h1>
                    <div class="flex flex-col gap-3 p-3 w-full">
                        <div class="flex justify-between">
                            <span>Total MRP</span>
                            <span>₹ <%= totalMRP %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Discount MRP</span>
                            <span>₹ <%= discount %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Platform Fee</span>
                            <span>₹ <%= platformFee %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Shipping Charges</span> 
                            <span>₹ <%= shippingcharge %></span>
                        </div>
                    </div>
                    <hr class="m-5 text-zinc-200">
                    <div class="flex justify-between mx-3 bg-zinc-200 px-4 py-2 rounded-md font-semibold">
                        <span>Total Amount</span>
                        <span>₹ <%= totalAmount %></span>
                    </div>
                    <div class="mt-5 mx-3">
                        <a href=""
                            class="w-full flex justify-center items-center bg-zinc-800 text-white px-6 py-2 rounded-md transition duration-200 hover:scale-95 cursor-pointer">Place
                            Order</a>
                    </div>
                    <div class="text-center mt-4">
                        <span class="text-zinc-400 flex justify-center items-center gap-1"> <img class="w-5 h-5" src="/images/shield.png" alt="Shield"> Secure Checkout</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>